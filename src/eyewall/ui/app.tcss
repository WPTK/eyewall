/* eyewall layout. The main screen's three sizes are described under "main screen" below. */

Screen {
    background: $background;
    color: $foreground;
}

/* Scrollbars follow the theme: the track blends into the panel and the thumb is a muted primary. Textual draws a bar
   only where the content overflows. */
* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary 50%;
    scrollbar-color-hover: $primary 75%;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

TooSmallScreen {
    align: center middle;
}

#too-small {
    width: auto;
    max-width: 100%;
}

/* ---- chrome: the top bar and the footer, one row each on every screen ---- */

TopBar {
    dock: top;
    height: 1;
    background: $panel;
}

FooterBar {
    dock: bottom;
    height: 1;
    background: $panel;
}

/* ---- main screen ----
   The map is the one element that grows. The screen carries a layout class (tier-small, tier-medium, tier-large) from
   `ui.screens.main.tier_for`: small has no column and shows the strip under the map, the others show the column. */

#lead {
    height: auto;
    max-height: 3;
    padding: 0 1;
}

#body {
    height: 1fr;
}

#map-pane {
    width: 1fr;
    height: 100%;
}

MapView {
    height: 1fr;
}

.legend {
    height: 1;
    color: $text-muted;
}

#side {
    display: none;
    height: 100%;
    padding: 0 1;
    border-left: solid $primary 50%;
}

#strip {
    display: none;
    height: auto;
    padding: 0 1;
}

MainScreen.tier-medium #side {
    display: block;
    width: 34;
}

MainScreen.tier-large #side {
    display: block;
    width: 50;
}

MainScreen.tier-small #strip {
    display: block;
}

MainScreen.full-map #side,
MainScreen.full-map #strip {
    display: none;
}

/* ---- storm and NHC text ---- */

#storm-scroll, #text-scroll {
    height: 1fr;
}

#storm-page {
    padding: 0 1;
}

#text-tabs {
    height: 3;
}

#text-head {
    height: auto;
    padding: 0 1;
}

#text-stale {
    height: auto;
    padding: 0 1;
    background: $panel;
}

#text-body {
    padding: 0 1;
}

/* ---- buoys and stations ---- */

#buoys-tabs {
    height: 3;
}

#buoys-head, #buoys-empty {
    height: auto;
    padding: 0 1;
}

#buoys-list {
    height: 1fr;
    border: none;
    padding: 0;
}

#station-lead {
    height: auto;
    padding: 0 1;
}

#station-about {
    height: auto;
    padding: 0 1;
    background: $panel;
}

#station-charts, #station-readings {
    height: 1fr;
}

#station-charts ChartView {
    height: 1fr;
    min-height: 6;
}

#station-table {
    padding: 0 1;
}

/* ---- alert log, help, layers ---- */

#alert-table {
    height: 1fr;
}

HelpScreen, FeedsScreen, LayerMenu, MarkChooser {
    align: center middle;
}

#help-box, #feeds-box {
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    border: round $accent;
    background: $panel;
    padding: 0 2;
}

#chooser-box {
    width: 60;
    max-width: 96%;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $panel;
}

#layer-box {
    width: 44;
    height: auto;
    border: round $accent;
    background: $panel;
}

/* The text tabs fit in 80 columns: one space between labels. */
NhcTextScreen Tab, BuoysScreen Tab {
    padding: 0 1 0 0;
}

/* One style for the selected tab on every tab bar, focused or not: bold and underlined (the bar below it also marks
   it), never a filled block, so the selection does not rely on colour. */
Tabs .-active,
Tabs:focus .-active {
    color: $foreground;
    background: transparent;
    text-style: bold underline;
}

Tabs:focus .underline--bar {
    background: $foreground 10%;
}

/* Unchecked layers stay readable: the box is muted, not the same dark as the dialog. */
SelectionList > .selection-list--button {
    color: $text-muted;
    background: $surface;
}

SelectionList > .selection-list--button-selected {
    color: $success;
    background: $surface;
}

/* ---- station search and settings ---- */

SettingsScreen {
    align: center middle;
}

#settings-box {
    width: 72;
    max-width: 96%;
    height: 90%;
    border: round $accent;
    background: $panel;
}

#settings-scroll {
    height: 1fr;
    padding: 0 1;
}

.settings-head {
    height: 1;
    margin-top: 1;
    text-style: bold;
    color: $secondary;
}

.settings-row {
    height: 3;
}

.settings-label {
    width: 42;
    height: 3;
    content-align: left middle;
}

.settings-row Input {
    width: 16;
}

.settings-row Select {
    width: 24;
}

#settings-note {
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
    border-top: solid $error 50%;
}

/* ---- graphics gallery ---- */

GalleryPanel {
    height: 1fr;
}

#gal-body {
    height: 1fr;
}

#gal-list {
    width: 34;
    height: 1fr;
    border: none;
}

#gal-main {
    width: 1fr;
    height: 1fr;
}

#gal-caption {
    height: auto;
    max-height: 4;
    padding: 0 1;
}

#gal-view, #gal-inline {
    height: 1fr;
    width: 1fr;
    margin-bottom: 1;  /* the picture stops a row above the footer */
}

#graphics-title {
    height: 1;
    background: $panel;
}

