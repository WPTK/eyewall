/* eyewall layout. Widths: wide (110+) shows the panels beside the map; narrow folds them into tabs; compact (< 90)
   hides the map until `m`. The screen carries the matching classes: narrow, compact, show-map, hide-map, full-map. */

Screen {
    background: $background;
    color: $foreground;
}

/* Scrollbars follow the theme: the track blends into the panel and the thumb is a muted primary. Textual draws a bar
   only where the content overflows. */
* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary 50%;
    scrollbar-color-hover: $primary 75%;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

/* ---- dashboard ---- */

#main {
    height: 1fr;
}

#storms {
    width: 36;
    height: 100%;
    border: round $primary 50%;
    background: $surface;
    padding: 0;
}

#storms:focus {
    border: round $accent;
}

#storms > .option-list--option-highlighted {
    background: $primary 30%;
}

#map-pane {
    width: 1fr;
    height: 100%;
    border: round $primary 50%;
}

#map-pane:focus-within {
    border: round $accent;
}

MapView {
    height: 1fr;
}

.legend {
    height: 1;
    color: $text-muted;
}

#side-stack {
    width: 44;
    height: 100%;
}

#side-tabs {
    display: none;
    width: 38;
    height: 100%;
}

.panel {
    height: auto;
    min-height: 3;
    max-height: 12;
    border: round $primary 50%;
    padding: 0 1;
    background: $surface;
}

.panel:focus {
    border: round $accent;
}

.panel Static {
    width: 100%;
    height: auto;
}

#side-stack .wind {
    max-height: 15;
}

#side-stack .headline {
    max-height: 20;
}

#side-stack .surge {
    max-height: 8;
}

#side-tabs .panel {
    max-height: 100%;
    height: 100%;
}

#side-tabs Tab {
    padding: 0 1;
}

#side-tabs TabPane {
    padding: 0;
}

#side-tabs .panel {
    border: none;
}

#status, #detail-status, #outlook-status, #graphics-status {
    dock: bottom;
    height: 1;
    background: $panel;
    padding: 0;
}

DashboardScreen.narrow #side-stack {
    display: none;
}

DashboardScreen.narrow #side-tabs {
    display: block;
}

DashboardScreen.narrow #storms {
    width: 32;
}

DashboardScreen.compact #map-pane {
    display: none;
}

DashboardScreen.compact #side-tabs {
    width: 1fr;
}

DashboardScreen.compact.show-map #map-pane {
    display: block;
}

DashboardScreen.compact.show-map #side-tabs {
    display: none;
}

DashboardScreen.hide-map #map-pane {
    display: none;
}

DashboardScreen.hide-map #side-tabs {
    width: 1fr;
}

DashboardScreen.hide-map #side-stack {
    width: 1fr;
}

DashboardScreen.full-map #storms,
DashboardScreen.full-map #side-stack,
DashboardScreen.full-map #side-tabs {
    display: none;
}

DashboardScreen.full-map #map-pane {
    display: block;
}

/* ---- storm detail ---- */

#detail-title {
    height: 1;
    background: $panel;
}

#detail-tabs {
    height: 1fr;
}

.note {
    height: 1;
    padding: 0 1;
}

StormDetailScreen DataTable {
    height: 1fr;
}

.detail-text {
    padding: 0 1;
}

/* ---- outlook ---- */

#outlook-main {
    height: 1fr;
}

#outlook-left {
    width: 1fr;
    height: 100%;
    border: round $primary 50%;
}

#outlook-scroll {
    height: 1fr;
    padding: 0 1;
}

#watchlist-title {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $secondary;
}

#watchlist {
    height: 7;
}

#outlook-map {
    width: 1fr;
    height: 100%;
    border: round $primary 50%;
}

/* ---- alert log, help, layers ---- */

#alert-table {
    height: 1fr;
}

HelpScreen, LayerMenu {
    align: center middle;
}

#help-box {
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    border: round $accent;
    background: $panel;
    padding: 0 2;
}

#layer-box {
    width: 44;
    height: auto;
    border: round $accent;
    background: $panel;
}

StormDetailScreen Tab {
    padding: 0 1;
}

/* ---- buoy detail ---- */

#buoy-title {
    height: 1;
    background: $panel;
}

#buoy-body {
    height: 1fr;
}

#buoy-charts {
    width: 1fr;
    height: 100%;
}

#buoy-info {
    width: 50;
    height: 100%;
    border: round $primary 50%;
    padding: 0 1;
}

BuoyDetailScreen.narrow #buoy-info {
    display: none;
}

BuoyDetailScreen.narrow.show-info #buoy-info {
    display: block;
    width: 1fr;
}

BuoyDetailScreen.narrow.show-info #buoy-charts {
    display: none;
}

#buoy-status, #watch-status {
    dock: bottom;
    height: 1;
    background: $panel;
}

/* ---- watchlist ---- */

#watch-main {
    height: 1fr;
}

.watch-title {
    height: 1;
    background: $panel;
}

#watch-buoys, #watch-tides {
    height: 1fr;
}

/* ---- station search and settings ---- */

SearchScreen, SettingsScreen {
    align: center middle;
}

#search-box {
    width: 76;
    max-width: 96%;
    height: 22;
    max-height: 92%;
    border: round $accent;
    background: $panel;
}

#search-results {
    height: 1fr;
    background: $panel;
}

#search-note {
    height: 1;
    padding: 0 1;
}

#settings-box {
    width: 72;
    max-width: 96%;
    height: 90%;
    border: round $accent;
    background: $panel;
}

#settings-scroll {
    height: 1fr;
    padding: 0 1;
}

.settings-head {
    height: 1;
    margin-top: 1;
    text-style: bold;
    color: $secondary;
}

.settings-row {
    height: 3;
}

.settings-label {
    width: 42;
    height: 3;
    content-align: left middle;
}

.settings-row Input {
    width: 16;
}

.settings-row Select {
    width: 24;
}

#settings-note {
    height: 1;
    padding: 0 1;
}

/* ---- graphics gallery ---- */

GalleryPanel {
    height: 1fr;
}

#gal-body {
    height: 1fr;
}

#gal-list {
    width: 34;
    height: 1fr;
    border: none;
}

#gal-main {
    width: 1fr;
    height: 1fr;
}

#gal-caption {
    height: auto;
    max-height: 4;
    padding: 0 1;
}

#gal-view, #gal-inline {
    height: 1fr;
    width: 1fr;
}

#gal-hint {
    height: 1;
    padding: 0 1;
}

#graphics-title {
    height: 1;
    background: $panel;
}

